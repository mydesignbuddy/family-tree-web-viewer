1 _META <metadataxml><content><line>&lt;p&gt;Birth:&amp;nbsp;May 11, 1769, Virginia, USA.&amp;nbsp; Death:&amp;nbsp;Aug. 26, 1838, Danville, Hendricks County, Indiana, USA.&amp;nbsp;&amp;nbsp;&lt;/p&gt;</line><line>&lt;p&gt;&amp;nbsp;&lt;/p&gt;</line><line
